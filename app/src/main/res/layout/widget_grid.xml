<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wmTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
                android:textStyle="bold"
            android:textColor="#AAFFFFFF"
            android:maxLines="1"
            android:text="Altivane · 运动" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/wmV1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                    android:textColor="#40E0FF"
                    android:maxLines="1"
                    android:text="--" />
                <TextView
                    android:id="@+id/wmL1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:maxLines="1"
                    android:text="时速 km/h" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/wmV2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                    android:textColor="#5B9DFF"
                    android:maxLines="1"
                    android:text="--" />
                <TextView
                    android:id="@+id/wmL2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:maxLines="1"
                    android:text="里程 km" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/wmV3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                    android:textColor="#A3E635"
                    android:maxLines="1"
                    android:text="--" />
                <TextView
                    android:id="@+id/wmL3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:maxLines="1"
                    android:text="时长" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/wmV4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                    android:textColor="#FF6B8A"
                    android:maxLines="1"
                    android:text="--" />
                <TextView
                    android:id="@+id/wmL4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                android:textStyle="bold"
                    android:textColor="#88FFFFFF"
                    android:maxLines="1"
                    android:text="心率 bpm" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
